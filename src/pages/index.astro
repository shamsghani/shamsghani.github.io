---
import Base from '../layouts/Base.astro';
import PsfResolvingStage from '../components/PsfResolvingStage.astro';
import FigureDeepFocus from '../components/FigureDeepFocus.astro';
import FigureMetacognition from '../components/FigureMetacognition.astro';
import { site, caseStudies } from '../data/site';

const deepFocus = caseStudies.find(c => c.slug === 'deep-focus')!;
const metacognition = caseStudies.find(c => c.slug === 'metacognitive-harness-scs')!;
const contrastive = caseStudies.find(c => c.slug === 'contrastive-representation-adaptation')!;
const openmouse = site.openSourceContributions[0];
---

<Base>
  <!-- ================= 1. HERO STICKY STAGE (200svh track) ================= -->
  <section class="hero-track" id="hero">
    <div class="hero-stage">
      <div class="hero-content">
        <!-- Left: Editorial Typography & Thesis -->
        <div class="hero-editorial" data-reveal="up">
          <div class="hero-kicker">
            <span class="mono-badge">MACHINE LEARNING ENGINEER</span>
            <span class="kicker-text">QUEEN'S UNIVERSITY BELFAST ALUMNUS · COMPUTER VISION & REPRESENTATION LEARNING</span>
          </div>

          <h1 class="hero-name" data-split="chars" data-intro>
            SHAMS GHANI
          </h1>

          <p class="hero-thesis">
            Machine Learning Engineer with production computer vision experience and research in scientific imaging. I work on perception and representation learning, from 
            <strong>single-molecule microscopy</strong> and <strong>loss design</strong> to 
            <strong>contrastive retrieval embeddings</strong>, and I'm prototyping a supervisory harness for iterative LLM reasoning.
          </p>

          <div class="hero-badges">
            <div class="badge-item">
              <span class="badge-dot"></span>
              <span>Graduate Trainee @ Itanz (Oct 2026 to Present)</span>
            </div>
            <div class="badge-item">
              <span class="badge-dot cyan"></span>
              <span>MSc AI (Queen's Belfast) · Valid UK Visa till Jan 2028</span>
            </div>
          </div>

          <div class="hero-actions">
            <a href="#shipped" class="btn-primary" data-magnetic="0.25">
              <span>Shipped Systems</span>
              <span class="arrow-glyph">↓</span>
            </a>
            <a href="#research" class="btn-ghost">
              <span>SMLM Research</span>
              <span class="arrow-glyph">→</span>
            </a>
            <a href="/cv.pdf" target="_blank" class="btn-ghost">
              <span>Download CV (PDF)</span>
              <span class="arrow-glyph">↓</span>
            </a>
          </div>

          <div class="scroll-cue">
            <span class="cue-mouse"></span>
            <span class="cue-text">SCROLL TO RESOLVE OPTICAL SIGNAL</span>
          </div>
        </div>

        <!-- Right: The Signature SMLM Optical Resolving Reticle -->
        <div class="hero-interactive" data-reveal="scale" data-delay="0.15">
          <PsfResolvingStage />
        </div>
      </div>
    </div>
  </section>

  <!-- ================= 1. SHIPPED PRODUCTION SYSTEMS ================= -->
  <section class="section-container" id="shipped">
    <div class="section-header" data-reveal="up">
      <div class="section-num">01</div>
      <div class="section-title-wrap">
        <span class="section-kicker">PRODUCTION ML SYSTEMS</span>
        <h2 class="section-title">Shipped Production Systems</h2>
        <p class="section-subtitle">
          Computer vision pipelines, neural retrieval microservices, and automated cataloging shipped in production.
        </p>
      </div>
    </div>

    <div class="shipped-grid" data-reveal="up">
      {site.shippedSystems.map((item, idx) => (
        <div class="shipped-card">
          <div class="shipped-card-header">
            <span class="shipped-idx">SYS_{String(idx + 1).padStart(2, '0')}</span>
            <span class="shipped-tag">SHIPPED TO PRODUCTION</span>
          </div>
          <h3 class="shipped-title">{item.title}</h3>
          <p class="shipped-desc">{item.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ================= 2. DEEP FOCUS CASE STUDY ================= -->
  <section class="section-container" id="research">
    <div class="section-header" data-reveal="up">
      <div class="section-num">02</div>
      <div class="section-title-wrap">
        <span class="section-kicker">SCIENTIFIC IMAGING & LOSS TOPOLOGY</span>
        <h2 class="section-title">Deep FOCUS: Focal Loss in Single-Molecule Localization</h2>
        <p class="section-subtitle">
          On a 10,000-sample synthetic benchmark, a focal-loss objective outperformed the MSE, L1+L2 and BCE objectives used in regression baselines such as Deep-STORM: 33.8 dB PSNR versus 20.2 dB (L1+L2) and 17.1 dB (MSE).
        </p>
      </div>
    </div>

    <!-- Deep FOCUS Metrics Grid -->
    <div class="metrics-grid" data-reveal="up">
      {deepFocus.metrics.map(m => (
        <div class="metric-card">
          <span class="metric-label">{m.label}</span>
          <span class="metric-val">{m.value}</span>
        </div>
      ))}
    </div>

    <!-- Deep FOCUS Narrative -->
    <div class="case-narrative" data-reveal="up">
      <div class="narrative-col">
        <h3 class="narrative-heading">The Physical Bottleneck</h3>
        <p>{deepFocus.problem}</p>
      </div>
      <div class="narrative-col">
        <h3 class="narrative-heading">The Focal Loss Formulation</h3>
        <p>{deepFocus.hypothesis}</p>
      </div>
    </div>

    <!-- Fig 1: Anatomy Optical Nanoscopy Bench -->
    <FigureDeepFocus />

    <!-- Empirical Findings & Architecture -->
    <div class="case-details-grid" data-reveal="up">
      <div class="details-card">
        <h3 class="card-heading">Empirical Findings (10,000 Samples)</h3>
        <ul class="findings-list">
          {deepFocus.findings.map(f => (
            <li>{f}</li>
          ))}
        </ul>
      </div>

      <div class="details-card">
        <h3 class="card-heading">Modified U-Net Architecture</h3>
        <div class="arch-stack">
          {deepFocus.architecture.map((a) => (
            <div class="arch-row">
              <span class="arch-layer">{a.layer}</span>
              <span class="arch-spec">{a.spec}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ================= 3. METACOGNITIVE EXPERIMENT ================= -->
  <section class="section-container" id="metacognition">
    <div class="section-header" data-reveal="up">
      <div class="section-num">03</div>
      <div class="section-title-wrap">
        <span class="section-kicker">RESEARCH PROTOTYPE · ARCHITECTURE ONLY</span>
        <h2 class="section-title">SCS-1: Supervisory Harness for Iterative Reasoning</h2>
        <p class="section-subtitle">
          An experimental supervisory harness for iterative LLM reasoning. It tracks semantic drift between reasoning steps, checks NLI entailment to decide when to halt, and applies a temperature ramp when the model gets stuck in repeated reasoning.
        </p>
      </div>
    </div>

    <!-- Metacognitive Metrics Grid -->
    <div class="metrics-grid" data-reveal="up">
      {metacognition.metrics.map(m => (
        <div class="metric-card">
          <span class="metric-label">{m.label}</span>
          <span class="metric-val">{m.value}</span>
        </div>
      ))}
    </div>

    <!-- Metacognitive Narrative -->
    <div class="case-narrative" data-reveal="up">
      <div class="narrative-col">
        <h3 class="narrative-heading">The Unsupervised Rumination Dilemma</h3>
        <p>{metacognition.problem}</p>
      </div>
      <div class="narrative-col">
        <h3 class="narrative-heading">Multi-Signal Gating & The Escape Hypothesis</h3>
        <p>{metacognition.hypothesis}</p>
      </div>
    </div>

    <!-- Fig 2: Metacognitive Reasoning Harness Visualizer -->
    <FigureMetacognition />

    <!-- Details Grid -->
    <div class="case-details-grid" data-reveal="up">
      <div class="details-card">
        <h3 class="card-heading">Harness Architecture & Dynamics</h3>
        <ul class="findings-list">
          {metacognition.findings.map(f => (
            <li>{f}</li>
          ))}
        </ul>
      </div>

      <div class="details-card">
        <h3 class="card-heading">Cognitive Substrate Architecture</h3>
        <div class="arch-stack">
          {metacognition.architecture.map((a) => (
            <div class="arch-row">
              <span class="arch-layer">{a.layer}</span>
              <span class="arch-spec">{a.spec}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ================= 4. CONTRASTIVE REPRESENTATION LEARNING ================= -->
  <section class="section-container" id="embeddings">
    <div class="section-header" data-reveal="up">
      <div class="section-num">04</div>
      <div class="section-title-wrap">
        <span class="section-kicker">ITANZ ML TRAINEESHIP · VECTOR GEOMETRY</span>
        <h2 class="section-title">{contrastive.title}</h2>
        <p class="section-subtitle">
          {contrastive.summary}
        </p>
      </div>
    </div>

    <div class="contrastive-banner" data-reveal="up">
      <div class="metrics-grid" style="margin-bottom: 2rem;">
        {contrastive.metrics.map(m => (
          <div class="metric-card">
            <span class="metric-label">{m.label}</span>
            <span class="metric-val">{m.value}</span>
          </div>
        ))}
      </div>

      <div class="case-narrative" style="margin-bottom: 0;">
        <div class="narrative-col">
          <h3 class="narrative-heading">Cross-Game Homonyms & Vector Smear</h3>
          <p>{contrastive.problem}</p>
        </div>
        <div class="narrative-col">
          <h3 class="narrative-heading">Multiple Negatives Ranking Loss (MNRL)</h3>
          <p>{contrastive.hypothesis}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= 5. OPEN SOURCE CONTRIBUTIONS ================= -->
  <section class="section-container" id="contributions">
    <div class="section-header" data-reveal="up">
      <div class="section-num">05</div>
      <div class="section-title-wrap">
        <span class="section-kicker">OPEN SOURCE CONTRIBUTIONS</span>
        <h2 class="section-title">OpenMouse: Hardware Protocol Reverse Engineering</h2>
        <p class="section-subtitle">
          Sniffing USB HID interrupt transfers via Wireshark and building driverless WebHID browser drivers.
        </p>
      </div>
    </div>

    <div class="hardware-banner" data-reveal="up">
      <div class="hw-left">
        <div class="contribution-badge">
          <span class="contrib-tag">CORE PROTOCOL CONTRIBUTOR</span>
          <span class="contrib-repo">@openmouse/protocol</span>
        </div>
        <h3 class="hw-title">Driverless Peripheral Control via WebHID</h3>
        <p class="hw-desc">
          {openmouse.desc}
        </p>
        <div class="hw-actions">
          <a href={openmouse.repoUrl} target="_blank" rel="noopener noreferrer" class="btn-primary" data-magnetic="0.2">
            <span>View Repository on GitHub</span>
            <span class="arrow-glyph">↗</span>
          </a>
        </div>
      </div>

      <div class="hw-stats">
        <div class="hw-stat-item">
          <span class="hw-num">0</span>
          <span class="hw-lbl">Proprietary Drivers Needed</span>
        </div>
        <div class="hw-stat-item">
          <span class="hw-num">100%</span>
          <span class="hw-lbl">Browser Native WebHID</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= 6. ACADEMIC & PROFESSIONAL RECORD ================= -->
  <section class="section-container" id="record">
    <div class="section-header" data-reveal="up">
      <div class="section-num">06</div>
      <div class="section-title-wrap">
        <span class="section-kicker">TRAJECTORY</span>
        <h2 class="section-title">Academic & Professional Record</h2>
        <p class="section-subtitle">
          Queen's University Belfast, Itanz Graduate Traineeship, startup engineering deployments, and extracurricular leadership.
        </p>
      </div>
    </div>

    <div class="record-layout">
      <!-- Experience Column -->
      <div class="record-col" data-reveal="up">
        <h3 class="col-title">Professional Experience</h3>
        <div class="timeline">
          {site.experience.map(exp => (
            <div class="timeline-item">
              <div class="timeline-head">
                <span class="timeline-role">{exp.role}</span>
                <span class="timeline-period">{exp.period}</span>
              </div>
              <div class="timeline-org">{exp.organization} · <span class="timeline-type">{exp.type}</span></div>
              <ul class="timeline-bullets">
                {exp.bullets.map(b => (
                  <li>{b}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>

        <h3 class="col-title" style="margin-top: 3rem;">Leadership & Extracurricular</h3>
        <div class="timeline">
          {site.leadership.map(item => (
            <div class="timeline-item">
              <div class="timeline-head">
                <span class="timeline-role">{item.role}</span>
                <span class="timeline-period">{item.period}</span>
              </div>
              <div class="timeline-org">{item.organization} · <span class="timeline-type">{item.type}</span></div>
              <ul class="timeline-bullets">
                {item.bullets.map(b => (
                  <li>{b}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>

      <!-- Education & Skills Column -->
      <div class="record-col" data-reveal="up" data-delay="0.1">
        <h3 class="col-title">Education</h3>
        <div class="education-block">
          {site.education.map(edu => (
            <div class="edu-card">
              <div class="edu-degree">{edu.degree}</div>
              <div class="edu-inst">{edu.institution}</div>
              <div class="edu-period">{edu.period}</div>
              <div class="edu-thesis"><strong>Thesis:</strong> {edu.thesis}</div>
            </div>
          ))}
        </div>

        <h3 class="col-title" style="margin-top: 2.5rem;">Technical Capabilities</h3>
        <div class="skills-block">
          {site.skills.map(grp => (
            <div class="skill-group">
              <span class="skill-grp-title">{grp.group}</span>
              <div class="skill-tags">
                {grp.items.map(item => (
                  <span class="skill-tag">{item}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ================= HERO STAGE STYLES ================= */
  .hero-track {
    position: relative;
    height: 280svh;
    margin-bottom: 2rem;
  }

  .hero-stage {
    position: sticky;
    top: 0;
    height: 100svh;
    display: flex;
    align-items: center;
    padding: calc(var(--gutter) * 1.5) var(--gutter) var(--gutter);
    overflow: clip;
    max-width: var(--max-w);
    margin: 0 auto;
  }

  .hero-content {
    display: grid;
    grid-template-columns: 1.15fr 0.95fr;
    align-items: center;
    gap: clamp(2rem, 1.5rem + 3vw, 4.5rem);
    width: 100%;
  }

  .hero-editorial {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .hero-kicker {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--f-mono);
    font-size: var(--t-xs);
    color: var(--c-muted);
  }

  .mono-badge {
    padding: 0.2rem 0.5rem;
    background: rgba(0, 229, 163, 0.1);
    color: var(--c-accent);
    border: 1px solid rgba(0, 229, 163, 0.3);
    border-radius: 2px;
    font-weight: 500;
  }

  .hero-name {
    font-family: var(--f-display);
    font-size: var(--t-mega);
    font-weight: 700;
    line-height: 0.92;
    letter-spacing: -0.04em;
    color: var(--c-fg);
  }

  .hero-thesis {
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.2rem);
    line-height: 1.55;
    color: var(--c-muted);
    max-width: 48ch;
  }

  .hero-thesis strong {
    color: var(--c-fg);
    font-weight: 500;
  }

  .hero-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    font-family: var(--f-mono);
    font-size: var(--t-xs);
    color: var(--c-muted);
  }

  .badge-item {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.65rem;
    background: rgba(238, 243, 248, 0.04);
    border: 1px solid var(--c-line);
    border-radius: 2px;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--c-accent);
  }
  .badge-dot.cyan {
    background: var(--c-accent-alt);
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.4rem;
    background: var(--c-accent);
    color: #040507;
    font-family: var(--f-mono);
    font-size: var(--t-xs);
    font-weight: 600;
    border-radius: var(--radius);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 20px rgba(0, 229, 163, 0.35);
  }

  .btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.4rem;
    border: 1px solid var(--c-line-strong);
    color: var(--c-fg);
    font-family: var(--f-mono);
    font-size: var(--t-xs);
    border-radius: var(--radius);
    transition: all 0.2s ease;
  }

  .btn-ghost:hover {
    border-color: var(--c-accent);
    background: rgba(0, 229, 163, 0.08);
    transform: translateY(-2px);
  }

  .scroll-cue {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1rem;
    font-family: var(--f-mono);
    font-size: 0.68rem;
    color: var(--c-muted);
    letter-spacing: 0.08em;
  }

  .cue-mouse {
    width: 14px;
    height: 22px;
    border: 1.5px solid var(--c-muted);
    border-radius: 8px;
    position: relative;
  }

  .cue-mouse::before {
    content: '';
    position: absolute;
    top: 4px;
    left: 50%;
    transform: translateX(-50%);
    width: 2px;
    height: 4px;
    background: var(--c-accent);
    border-radius: 1px;
    animation: mouse-scroll 1.6s ease-in-out infinite;
  }

  @keyframes mouse-scroll {
    0%, 100% { transform: translate(-50%, 0); opacity: 1; }
    70% { transform: translate(-50%, 6px); opacity: 0; }
  }

  /* ================= SECTION LAYOUT ================= */
  .section-container {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: clamp(3.5rem, 2rem + 5vw, 7rem) var(--gutter);
  }

  .section-header {
    display: flex;
    gap: 1.5rem;
    align-items: baseline;
    margin-bottom: clamp(2rem, 1.5rem + 3vw, 4rem);
    border-bottom: 1px solid var(--c-line);
    padding-bottom: 1.5rem;
  }

  .section-num {
    font-family: var(--f-mono);
    font-size: var(--t-m);
    color: var(--c-accent);
    font-weight: 500;
  }

  .section-kicker {
    font-family: var(--f-mono);
    font-size: var(--t-xs);
    color: var(--c-accent);
    letter-spacing: 0.1em;
    display: block;
    margin-bottom: 0.35rem;
  }

  .section-title {
    font-family: var(--f-display);
    font-size: var(--t-xl);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin-bottom: 0.5rem;
  }

  .section-subtitle {
    font-size: var(--t-body);
    color: var(--c-muted);
    max-width: 55ch;
  }

  /* Metrics Grid */
  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  /* Shipped Systems Grid */
  .shipped-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .shipped-card {
    background: var(--c-card);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-card);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .shipped-card:hover {
    transform: translateY(-2px);
    border-color: var(--c-accent);
  }

  .shipped-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .shipped-idx {
    font-family: var(--f-mono);
    font-size: 0.7rem;
    color: var(--c-accent);
    letter-spacing: 0.05em;
  }

  .shipped-tag {
    font-family: var(--f-mono);
    font-size: 0.62rem;
    color: var(--c-muted);
    letter-spacing: 0.05em;
    background: rgba(238, 243, 248, 0.04);
    border: 1px solid var(--c-line);
    padding: 0.15rem 0.45rem;
    border-radius: 2px;
  }

  .shipped-title {
    font-family: var(--f-display);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--c-fg);
  }

  .shipped-desc {
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--c-muted);
    margin: 0;
  }

  :global([data-theme="light"]) .shipped-card {
    background: #ffffff;
    border-color: rgba(15, 23, 42, 0.1);
    box-shadow: 0 4px 18px rgba(15, 23, 42, 0.04);
  }

  :global([data-theme="light"]) .shipped-tag {
    background: #f1f5f9;
    border-color: rgba(15, 23, 42, 0.1);
    color: #475569;
  }

  .metric-card {
    background: var(--c-card);
    border: 1px solid var(--c-line);
    padding: 1.25rem 1rem;
    border-radius: var(--radius-card);
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .metric-label {
    font-family: var(--f-mono);
    font-size: 0.7rem;
    color: var(--c-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .metric-val {
    font-family: var(--f-mono);
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--c-accent);
    font-variant-numeric: tabular-nums;
  }

  /* Case Narrative */
  .case-narrative {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    margin-bottom: 3.5rem;
    background: var(--c-card);
    border: 1px solid var(--c-line);
    padding: 2rem;
    border-radius: var(--radius-card);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
  }

