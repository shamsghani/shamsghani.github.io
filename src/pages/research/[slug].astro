---
import Base from '../../layouts/Base.astro';
import FigureMetacognition from '../../components/FigureMetacognition.astro';
import FigureDeepFocus from '../../components/FigureDeepFocus.astro';
import FigureItanzRag from '../../components/FigureItanzRag.astro';
import { caseStudies } from '../../data/site';

export function getStaticPaths() {
  return caseStudies.map((study, idx) => ({
    params: { slug: study.slug },
    props: {
      study,
      nextStudy: caseStudies[(idx + 1) % caseStudies.length]
    }
  }));
}

const { study, nextStudy } = Astro.props;
---

<Base title={study.title} description={study.summary}>
  <article class="study-article" data-layer="content">
    <div class="study-container">
      <!-- Breadcrumb / Back Link -->
      <div class="study-nav-bar" data-reveal="fade">
        <a href="/#research" class="back-link" data-cursor="Back">
          <span class="back-arrow">←</span>
          <span>Index of Investigations</span>
        </a>
        <div class="study-pill">{study.category} // {study.year}</div>
      </div>

      <!-- Header -->
      <header class="study-header">
        <div class="study-institution" data-reveal="up">{study.institution}</div>
        <h1 class="study-headline" data-split="words" data-reveal="up" data-delay="0.1">
          {study.title}
        </h1>
        <p class="study-summary-lead" data-reveal="up" data-delay="0.2">
          {study.summary}
        </p>

        <!-- Key Metrics Strip -->
        <div class="study-metrics-strip" data-reveal="up" data-delay="0.3">
          {study.metrics.map((m) => (
            <div class="strip-item">
              <span class="strip-val">{m.value}</span>
              <span class="strip-lbl">{m.label}</span>
            </div>
          ))}
        </div>
      </header>

      <!-- Main Scientific Monograph Body -->
      <div class="study-body-grid">
        <!-- Main Column -->
        <div class="study-main-col">
          <!-- Problem & Context -->
          <section class="monograph-section" data-reveal="up">
            <h2 class="section-subheading">01 // Problem & Context</h2>
            <p class="section-p">{study.problem}</p>
          </section>

          <!-- Hypothesis & Formulation -->
          <section class="monograph-section" data-reveal="up">
            <h2 class="section-subheading">02 // Hypothesis & Objective Formulation</h2>
            <p class="section-p">{study.hypothesis}</p>
          </section>

          <!-- Embedded Anatomy Figure for this Study -->
          {(study.slug === 'metacognitive-harness-scs' || study.slug === 'metacognition-scs') && (
            <div class="study-instrument-slot" data-reveal="up" style="margin: 2rem 0;">
              <FigureMetacognition />
            </div>
          )}
          {study.slug === 'deep-focus' && (
            <div class="study-instrument-slot" data-reveal="up" style="margin: 2rem 0;">
              <FigureDeepFocus />
            </div>
          )}
          {study.slug === 'itanz-document-ai-rag' && (
            <div class="study-instrument-slot" data-reveal="up" style="margin: 2rem 0;">
              <FigureItanzRag />
            </div>
          )}

          <!-- Methodology Protocol -->
          <section class="monograph-section" data-reveal="up">
            <h2 class="section-subheading">03 // Experimental Protocol</h2>
            <ul class="methodology-steps">
              {study.methodology.map((step, sIdx) => (
                <li class="step-item">
                  <span class="step-num">{sIdx + 1}.</span>
                  <span class="step-text">{step}</span>
                </li>
              ))}
            </ul>
          </section>

          <!-- Key Findings -->
          <section class="monograph-section" data-reveal="up">
            <h2 class="section-subheading">04 // Empirical Findings & Analysis</h2>
            <div class="findings-cards">
              {study.findings.map((finding) => (
                <div class="finding-card">
                  <div class="finding-icon">✓</div>
                  <p class="finding-text">{finding}</p>
                </div>
              ))}
            </div>
          </section>

          <!-- Code & Artifacts Link -->
          {study.codeUrl && (
            <div class="study-code-banner" data-reveal="up">
              <div>
                <div class="code-banner-title">Code Repository & Replicability</div>
                <div class="code-banner-sub">PyTorch model code, Jupyter notebooks, and evaluation protocols.</div>
              </div>
              <a href={study.codeUrl} target="_blank" rel="noopener noreferrer" class="code-banner-btn" data-cursor="Git">
                <span>View on GitHub</span>
                <span>↗</span>
              </a>
            </div>
          )}
        </div>

        <!-- Sidebar / Architecture Column -->
        <aside class="study-sidebar-col" data-reveal="up" data-delay="0.15">
          <div class="sidebar-sticky-box">
            <h3 class="sidebar-title">Neural Architecture</h3>
            <div class="arch-table">
              {study.architecture.map((layer) => (
                <div class="arch-row">
                  <span class="arch-layer-name">{layer.layer}</span>
                  <span class="arch-layer-spec">{layer.spec}</span>
                </div>
              ))}
            </div>

            <div class="sidebar-meta-list">
              <div class="meta-entry">
                <span class="m-k">INVESTIGATOR:</span>
                <span class="m-v">Muhammad Shams Ghani</span>
              </div>
              <div class="meta-entry">
                <span class="m-k">INSTITUTION:</span>
                <span class="m-v">{study.institution}</span>
              </div>
              <div class="meta-entry">
                <span class="m-k">DOMAIN:</span>
                <span class="m-v">{study.category}</span>
              </div>
              <div class="meta-entry">
                <span class="m-k">YEAR:</span>
                <span class="m-v">{study.year}</span>
              </div>
            </div>
          </div>
        </aside>
      </div>

      <!-- Next Case Study Footer -->
      <div class="next-study-section" data-reveal="up">
        <div class="next-label">Next Investigation</div>
        <a href={`/research/${nextStudy.slug}`} class="next-study-card" data-cursor="Next">
          <div class="next-meta">{nextStudy.category} · {nextStudy.year}</div>
          <div class="next-title">{nextStudy.title}</div>
          <div class="next-arrow">Proceed to Study →</div>
        </a>
      </div>
    </div>
  </article>
</Base>

<style>
  .study-article {
    padding: clamp(6.5rem, 5rem + 4vw, 9rem) 0 6rem;
    min-height: 100vh;
  }
  .study-container {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .study-nav-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2.5rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--c-line);
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--f-mono);
    font-size: var(--t-xs);
    color: var(--c-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .back-link:hover {
    color: var(--c-accent);
  }
  .back-arrow {
    transition: transform 0.2s ease;
  }
  .back-link:hover .back-arrow {
    transform: translateX(-4px);
  }
  .study-pill {
    font-family: var(--f-mono);
    font-size: 11px;
    padding: 3px 9px;
    background: rgba(0, 229, 163, 0.1);
    color: var(--c-accent);
    border: 1px solid rgba(0, 229, 163, 0.25);
    border-radius: var(--radius);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .study-header {
    margin-bottom: clamp(3rem, 2rem + 3vw, 5rem);
    max-width: 980px;
  }
  .study-institution {
    font-family: var(--f-mono);
    font-size: var(--t-xs);
    color: var(--c-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 1rem;
  }
  .study-headline {
    font-family: var(--f-display);
    font-size: var(--t-xl);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--c-fg);
    margin-bottom: 1.5rem;
  }
  .study-summary-lead {
    font-size: var(--t-m);
    line-height: 1.6;
    color: var(--c-muted);
    margin-bottom: 2.5rem;
  }

  .study-metrics-strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 1rem;
    background: var(--c-card);
    border: 1px solid var(--c-line-strong);
    padding: 1.5rem;
    border-radius: var(--radius-card);
  }
  .strip-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .strip-val {
    font-family: var(--f-display);
    font-size: clamp(1.4rem, 1rem + 1vw, 2.2rem);
    font-weight: 600;
    color: var(--c-accent);
    line-height: 1.1;
  }
  .strip-lbl {
    font-family: var(--f-mono);
    font-size: 11px;
    color: var(--c-muted);
    letter-spacing: 0.02em;
  }

  /* Main Body Grid */
  .study-body-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: clamp(2.5rem, 1.5rem + 3vw, 5rem);
    align-items: start;
    margin-bottom: 5rem;
  }
  .study-main-col {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .monograph-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .section-subheading {
    font-family: var(--f-mono);
    font-size: var(--t-xs);
    color: var(--c-accent);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--c-line);
  }
  .section-p {
    font-size: var(--t-body);
    line-height: 1.75;
    color: var(--c-fg);
  }

  .methodology-steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .step-item {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }
  .step-num {
    font-family: var(--f-mono);
    font-size: var(--t-s);
    color: var(--c-accent);
    font-weight: 600;
  }
  .step-text {
    font-size: var(--t-body);
    color: var(--c-fg);
    line-height: 1.6;
  }

  .findings-cards {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .finding-card {
    display: flex;
    gap: 1rem;
    background: var(--c-card);
    border: 1px solid var(--c-line);
    padding: 1.25rem 1.5rem;
    border-radius: var(--radius-card);
    align-items: flex-start;
  }
  .finding-icon {
    color: var(--c-accent);
    font-weight: 700;
  }
  .finding-text {
    font-size: var(--t-s);
    color: var(--c-fg);
    line-height: 1.6;
    margin: 0;
  }

  .study-code-banner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: color-mix(in srgb, var(--c-accent) 8%, var(--c-card));
    border: 1px solid rgba(0, 229, 163, 0.3);
    padding: 1.75rem 2rem;
    border-radius: var(--radius-card);
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .code-banner-title {
    font-family: var(--f-display);
    font-size: var(--t-m);
    font-weight: 500;
    color: var(--c-fg);
    margin-bottom: 0.25rem;
  }
  .code-banner-sub {
    font-size: var(--t-xs);
    color: var(--c-muted);
  }
  .code-banner-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.4rem;
    background: var(--c-accent);
    color: var(--c-bg);
    font-family: var(--f-mono);
    font-size: var(--t-xs);
    font-weight: 600;
    text-decoration: none;
    border-radius: var(--radius);
    transition: all 0.25s ease;
  }
  .code-banner-btn:hover {
    background: #00ffb5;
    transform: translateY(-2px);
  }

  /* Sidebar Column */
  .sidebar-sticky-box {
    position: sticky;
    top: 6rem;
    background: var(--c-card);
    border: 1px solid var(--c-line-strong);
    border-radius: var(--radius-card);
    padding: 1.75rem;
  }
  .sidebar-title {
    font-family: var(--f-mono);
    font-size: var(--t-xs);
    color: var(--c-accent);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 1.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--c-line);
  }
  .arch-table {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }
  .arch-row {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding-bottom: 0.65rem;
    border-bottom: 1px solid var(--c-line);
  }
  .arch-layer-name {
    font-family: var(--f-mono);
    font-size: 11px;
    color: var(--c-accent-alt);
    font-weight: 600;
  }
  .arch-layer-spec {
    font-family: var(--f-mono);
    font-size: 10px;
    color: var(--c-muted);
  }

  .sidebar-meta-list {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }
  .meta-entry {
    display: flex;
    justify-content: space-between;
    font-family: var(--f-mono);
    font-size: 10.5px;
  }
  .m-k {
    color: var(--c-muted);
  }
  .m-v {
    color: var(--c-fg);
  }

  /* Next Study Footer */
  .next-study-section {
    padding-top: 3.5rem;
    border-top: 1px solid var(--c-line);
  }
  .next-label {
    font-family: var(--f-mono);
    font-size: var(--t-xs);
    color: var(--c-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 1rem;
  }
  .next-study-card {
    display: block;
    background: var(--c-card);
    border: 1px solid var(--c-line-strong);
    border-radius: var(--radius-card);
    padding: 2.5rem;
    text-decoration: none;
    transition: all 0.3s ease;
  }
  .next-study-card:hover {
    border-color: var(--c-accent);
    transform: translateY(-3px);
  }
  .next-meta {
    font-family: var(--f-mono);
    font-size: 11px;
    color: var(--c-accent);
    margin-bottom: 0.5rem;
  }
  .next-title {
    font-family: var(--f-display);
    font-size: var(--t-l);
    font-weight: 500;
    color: var(--c-fg);
    margin-bottom: 1rem;
  }
  .next-arrow {
    font-family: var(--f-mono);
    font-size: var(--t-xs);
    color: var(--c-muted);
    transition: color 0.2s ease, transform 0.2s ease;
  }
  .next-study-card:hover .next-arrow {
    color: var(--c-accent);
    transform: translateX(4px);
  }

  @media (max-width: 960px) {
    .study-body-grid { grid-template-columns: 1fr; }
  }
</style>
