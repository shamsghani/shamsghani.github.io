---
// PsfResolvingStage.astro — The Signature SMLM Optical Resolving Reticle
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<div class={`psf-stage ${className}`} id="psf-stage" data-psf-container>
  <!-- Reticle Window Header -->
  <div class="psf-header">
    <div class="psf-header__left">
      <span class="psf-indicator" aria-hidden="true"></span>
      <span class="psf-tag">OPTICAL RETICLE · SMLM RESOLVER</span>
    </div>
    <div class="psf-header__right">
      <span class="psf-coords">λ = 525nm · NA = 1.49</span>
    </div>
  </div>

  <!-- Viewport Frame with Reticle Marks -->
  <div class="psf-viewport">
    <canvas id="psf-canvas" class="psf-canvas" aria-label="Interactive Single-Molecule Localization Microscopy point-spread function simulation resolving on scroll"></canvas>
    
    <!-- Optical Crosshairs & Reticle Overlay -->
    <div class="psf-crosshairs" aria-hidden="true">
      <div class="reticle-corner reticle-tl"></div>
      <div class="reticle-corner reticle-tr"></div>
      <div class="reticle-corner reticle-bl"></div>
      <div class="reticle-corner reticle-br"></div>
      <div class="reticle-center"></div>
      <div class="reticle-scale">
        <span>200nm (DIFFRACTION LIMIT)</span>
        <div class="scale-bar"></div>
      </div>
    </div>
  </div>

  <!-- Telemetry HUD Footer -->
  <div class="psf-hud" aria-live="polite">
    <div class="hud-item">
      <span class="hud-label">OBJECTIVE</span>
      <span class="hud-value" data-hud="objective">Focal Loss (γ=2.0)</span>
    </div>
    <div class="hud-item">
      <span class="hud-label">PSNR METRIC</span>
      <span class="hud-value hud-accent" data-hud="psnr">18.2 dB</span>
    </div>
    <div class="hud-item">
      <span class="hud-label">EMITTER FWHM</span>
      <span class="hud-value" data-hud="fwhm">280 nm</span>
    </div>
    <div class="hud-item">
      <span class="hud-label">REGIME</span>
      <span class="hud-value" data-hud="regime">Diffraction Blur</span>
    </div>
  </div>
</div>

<style>
  .psf-stage {
    position: relative;
    width: 100%;
    max-width: 580px;
    background: var(--c-card, #0f131a);
    border: 1px solid var(--c-line-strong, rgba(238, 243, 248, 0.14));
    border-radius: var(--radius-card, 4px);
    overflow: hidden;
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.45);
    transition: border-color 0.3s ease;
  }

  .psf-stage:hover {
    border-color: rgba(56, 189, 248, 0.35);
  }

  .psf-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.65rem 0.9rem;
    background: rgba(8, 10, 14, 0.85);
    border-bottom: 1px solid var(--c-line, rgba(238, 243, 248, 0.08));
    font-family: var(--f-mono);
    font-size: var(--t-xs, 0.72rem);
    letter-spacing: 0.04em;
  }

  .psf-header__left {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .psf-indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--c-accent, #00e5a3);
    box-shadow: 0 0 8px var(--c-accent, #00e5a3);
    animation: pulse-dot 2.4s ease-in-out infinite;
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 0.4; }
    50% { opacity: 1; }
  }

  .psf-tag {
    color: #eef3f8;
    font-weight: 500;
  }

  .psf-coords {
    color: #94a3b8;
  }

  .psf-viewport {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 11;
    background: #040507;
    overflow: hidden;
  }

  .psf-canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  .psf-crosshairs {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .reticle-corner {
    position: absolute;
    width: 12px;
    height: 12px;
    border-color: rgba(238, 243, 248, 0.25);
    border-style: solid;
  }

  .reticle-tl { top: 12px; left: 12px; border-width: 1px 0 0 1px; }
  .reticle-tr { top: 12px; right: 12px; border-width: 1px 1px 0 0; }
  .reticle-bl { bottom: 12px; left: 12px; border-width: 0 0 1px 1px; }
  .reticle-br { bottom: 12px; right: 12px; border-width: 0 1px 1px 0; }

  .reticle-center {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 16px;
    height: 16px;
    transform: translate(-50%, -50%);
    border: 1px solid rgba(56, 189, 248, 0.2);
    border-radius: 50%;
  }

  .reticle-center::before,
  .reticle-center::after {
    content: '';
    position: absolute;
    background: rgba(56, 189, 248, 0.25);
  }

  .reticle-center::before {
    top: -6px; bottom: -6px; left: 50%; width: 1px;
    transform: translateX(-50%);
  }

  .reticle-center::after {
    left: -6px; right: -6px; top: 50%; height: 1px;
    transform: translateY(-50%);
  }

  .reticle-scale {
    position: absolute;
    bottom: 12px;
    right: 14px;
    font-family: var(--f-mono);
    font-size: 0.65rem;
    color: #cbd5e1;
    text-align: right;
  }

  .scale-bar {
    width: 60px;
    height: 2px;
    background: #cbd5e1;
    margin-top: 3px;
    margin-left: auto;
    position: relative;
  }

  .scale-bar::before,
  .scale-bar::after {
    content: '';
    position: absolute;
    top: -2px;
    width: 1px;
    height: 6px;
    background: #cbd5e1;
  }
  .scale-bar::before { left: 0; }
  .scale-bar::after { right: 0; }

  .psf-hud {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.5rem;
    padding: 0.75rem 0.9rem;
    background: rgba(8, 10, 14, 0.95);
    border-top: 1px solid var(--c-line, rgba(238, 243, 248, 0.08));
    font-family: var(--f-mono);
  }

  .hud-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .hud-label {
    font-size: 0.62rem;
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .hud-value {
    font-size: 0.8rem;
    color: #eef3f8;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  .hud-accent {
    color: var(--c-accent, #00e5a3);
  }

  /* Light Theme Laboratory Instrument Overrides */
  :global([data-theme="light"]) .psf-stage {
    background: #ffffff;
    border-color: rgba(15, 23, 42, 0.12);
    box-shadow: 0 12px 32px rgba(15, 23, 42, 0.06);
  }

  :global([data-theme="light"]) .psf-header {
    background: #f8fafc;
    border-bottom-color: rgba(15, 23, 42, 0.08);
  }

  :global([data-theme="light"]) .psf-tag {
    color: #0f172a;
  }

  :global([data-theme="light"]) .psf-coords {
    color: #64748b;
  }

  :global([data-theme="light"]) .psf-hud {
    background: #f8fafc;
    border-top-color: rgba(15, 23, 42, 0.08);
  }

  :global([data-theme="light"]) .hud-label {
    color: #64748b;
  }

  :global([data-theme="light"]) .hud-value {
    color: #0f172a;
  }

  :global([data-theme="light"]) .hud-accent {
    color: #059669;
  }

  @media (max-width: 600px) {
    .psf-hud {
      grid-template-columns: repeat(2, 1fr);
      row-gap: 0.6rem;
    }
  }
</style>

<script>
  import { onPage, onScroll, prefersReducedMotion } from '@/engine';

  onPage(() => {
    const canvas = document.getElementById('psf-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const hudPsnr = document.querySelector('[data-hud="psnr"]');
    const hudFwhm = document.querySelector('[data-hud="fwhm"]');
    const hudRegime = document.querySelector('[data-hud="regime"]');

    let width = 0;
    let height = 0;
    let dpr = 1;

    // Biological Microtubule / Filament Coordinate Topology
    // These points form structured filaments when connected, but appear as random spots when zoomed in
    const filaments = [
      // Filament A (diagonal curving strand)
      [
        { x: 0.12, y: 0.85 }, { x: 0.22, y: 0.74 }, { x: 0.32, y: 0.65 },
        { x: 0.42, y: 0.54 }, { x: 0.52, y: 0.46 }, { x: 0.62, y: 0.38 },
        { x: 0.74, y: 0.28 }, { x: 0.88, y: 0.15 }
      ],
      // Filament B (crossing strand with branching node)
      [
        { x: 0.18, y: 0.22 }, { x: 0.28, y: 0.35 }, { x: 0.38, y: 0.48 },
        { x: 0.50, y: 0.52 }, { x: 0.64, y: 0.62 }, { x: 0.78, y: 0.75 },
        { x: 0.86, y: 0.84 }
      ],
      // Filament C (horizontal supporting microtubule)
      [
        { x: 0.15, y: 0.48 }, { x: 0.26, y: 0.50 }, { x: 0.38, y: 0.48 },
        { x: 0.50, y: 0.52 }, { x: 0.62, y: 0.50 }, { x: 0.75, y: 0.46 },
        { x: 0.86, y: 0.42 }
      ],
      // Cluster D (mitotic aster cluster center)
      [
        { x: 0.50, y: 0.50 }, { x: 0.48, y: 0.45 }, { x: 0.54, y: 0.47 },
        { x: 0.52, y: 0.55 }, { x: 0.46, y: 0.53 }, { x: 0.53, y: 0.51 }
      ]
    ];

    // Flatten into individual emitter points with initial random phases for idle blinking
    type Emitter = {
      x: number;
      y: number;
      phase: number;
      intensity: number;
      filamentIdx: number;
    };

    const emitters: Emitter[] = [];
    filaments.forEach((strand, fIdx) => {
      strand.forEach((pt) => {
        emitters.push({
          x: pt.x,
          y: pt.y,
          phase: Math.random() * Math.PI * 2,
          intensity: 0.7 + Math.random() * 0.3,
          filamentIdx: fIdx
        });
      });
    });

    function resize() {
      if (!canvas) return;
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      const rect = canvas.getBoundingClientRect();
      width = rect.width;
      height = rect.height;
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      ctx?.scale(dpr, dpr);
    }

    resize();
    window.addEventListener('resize', resize);

    // Scroll progress driver state
    let scrollProgress = 0;
    let targetProgress = 0;
    let pointerX = 0;
    let pointerY = 0;
    let idleTime = 0;
    let animationFrameId: number;

    // Track mouse hover over canvas
    canvas.addEventListener('mousemove', (e) => {
      const rect = canvas.getBoundingClientRect();
      pointerX = (e.clientX - rect.left) / rect.width - 0.5;
      pointerY = (e.clientY - rect.top) / rect.height - 0.5;
    });

    canvas.addEventListener('mouseleave', () => {
      pointerX = 0;
      pointerY = 0;
    });

    // Measure exact scroll progress inside #hero track
    function updateHeroScroll() {
      const heroTrack = document.getElementById('hero');
      if (!heroTrack) return;
      const rect = heroTrack.getBoundingClientRect();
      const trackHeight = heroTrack.offsetHeight;
      const viewHeight = window.innerHeight;
      const totalScroll = trackHeight - viewHeight;
      if (totalScroll <= 0) {
        targetProgress = 1;
        return;
      }
      // Scrolled distance within the hero track
      const scrolled = -rect.top;
      targetProgress = Math.min(Math.max(scrolled / totalScroll, 0), 1);
    }

    // Connect to scroll engine
    const unbindScroll = onScroll(() => {
      updateHeroScroll();
    });

    // Initial check
    updateHeroScroll();

    const isReduced = prefersReducedMotion();

    function render() {
      if (!ctx || !canvas) return;

      // Smooth progress interpolation
      if (isReduced) {
        scrollProgress = 1;
      } else {
        scrollProgress += (targetProgress - scrollProgress) * 0.14;
      }

      idleTime += 0.025;

      ctx.clearRect(0, 0, width, height);

      // Background optical noise field (slight dark-field laboratory glow)
      const bgGrad = ctx.createRadialGradient(
        width * (0.5 + pointerX * 0.1),
        height * (0.5 + pointerY * 0.1),
        10,
        width * 0.5,
        height * 0.5,
        width * 0.7
      );
      bgGrad.addColorStop(0, 'rgba(10, 24, 28, 0.45)');
      bgGrad.addColorStop(0.6, 'rgba(6, 12, 18, 0.2)');
      bgGrad.addColorStop(1, 'rgba(4, 5, 7, 0.95)');
      ctx.fillStyle = bgGrad;
      ctx.fillRect(0, 0, width, height);

      // Subtle laser scan beam across the optical aperture (idle optical sweep)
      if (!isReduced) {
        const sweepY = ((idleTime * 50) % (height + 90)) - 45;
        const scanGrad = ctx.createLinearGradient(0, sweepY - 25, 0, sweepY + 25);
        scanGrad.addColorStop(0, 'rgba(0, 229, 163, 0)');
        scanGrad.addColorStop(0.5, 'rgba(56, 189, 248, 0.22)');
        scanGrad.addColorStop(1, 'rgba(0, 229, 163, 0)');
        ctx.fillStyle = scanGrad;
        ctx.fillRect(0, sweepY - 25, width, 50);
      }

      // Physical optical parameters derived from scrollProgress p:
      // p in [0.0, 1.0]:
      // 1. Stage A (0.0 -> 0.35): Point Spread Function (PSF) localization
      //    Overlapping Gaussians contract from sigma=55px down to pinpoint centroids (1.8px).
      // 2. Stage B (0.28 -> 0.68): Macroscopic zoom-out
      //    The camera zooms out (scale 1.0 -> 0.60) revealing that the localized centroids
      //    belong to an interconnected biological microtubule network.
      // 3. Stage C (0.68 -> 1.00): Fully resolved, stable inspection window
      //    Held crystal clear in full frame before the hero unpins!
      const p = scrollProgress;

      // Blur radius sigma contracts rapidly in first 35% of scroll
      const blurP = Math.min(p / 0.35, 1);
      const sigma = Math.max(55 * Math.pow(1 - blurP, 2.4) + 1.8, 1.8);

      // Camera zoom out factor (1.0 at start, zooms out to 0.60 between p=0.28 and p=0.68)
      const zoomP = Math.min(Math.max((p - 0.28) / 0.40, 0), 1);
      const viewScale = 1.0 - zoomP * 0.40;

      const centerX = width * 0.5;
      const centerY = height * 0.5;

      ctx.save();
      ctx.translate(centerX, centerY);
      ctx.scale(viewScale, viewScale);
      ctx.translate(-centerX, -centerY);

      // Add gentle pointer deflection
      const deflectionX = pointerX * 18 * (1 - p * 0.5);
      const deflectionY = pointerY * 18 * (1 - p * 0.5);

      // Draw filament interconnects as zoom progresses
      if (p > 0.28) {
        const filamentAlpha = Math.min((p - 0.28) / 0.35, 1) * 0.75;
        ctx.strokeStyle = `rgba(0, 229, 163, ${filamentAlpha})`;
        ctx.lineWidth = 1.4 / viewScale;

        filaments.forEach((strand) => {
          ctx.beginPath();
          strand.forEach((pt, i) => {
            const x = pt.x * width + deflectionX;
            const y = pt.y * height + deflectionY;
            if (i === 0) ctx.moveTo(x, y);
            else ctx.lineTo(x, y);
          });
          ctx.stroke();
        });
      }

      // Draw fluorophore emitters (Gaussians resolving into sharp spots)
      emitters.forEach((emitter) => {
        // Idle photon blinking
        const blink = Math.sin(idleTime * 1.8 + emitter.phase) * 0.15 + 0.85;
        const currentIntensity = emitter.intensity * blink;

        const x = emitter.x * width + deflectionX;
        const y = emitter.y * height + deflectionY;

        // In Phase 1 (p < 0.6): render 2D Gaussian point spread function
        if (sigma > 3.0) {
          const radGrad = ctx.createRadialGradient(x, y, 0, x, y, sigma * 1.8);
          // 525nm GFP green core with 488nm cyan excitation fringe
          radGrad.addColorStop(0, `rgba(0, 229, 163, ${0.45 * currentIntensity})`);
          radGrad.addColorStop(0.35, `rgba(56, 189, 248, ${0.28 * currentIntensity})`);
          radGrad.addColorStop(0.7, `rgba(30, 58, 138, ${0.12 * currentIntensity})`);
          radGrad.addColorStop(1, 'rgba(0, 0, 0, 0)');

          ctx.fillStyle = radGrad;
          ctx.beginPath();
          ctx.arc(x, y, sigma * 1.8, 0, Math.PI * 2);
          ctx.fill();
        }

        // Pinpoint localized centroid (sharp coordinate star)
        const pointAlpha = Math.min(p / 0.35, 1);
        if (pointAlpha > 0.1) {
          ctx.fillStyle = `rgba(238, 243, 248, ${pointAlpha * currentIntensity})`;
          ctx.beginPath();
          ctx.arc(x, y, 1.8, 0, Math.PI * 2);
          ctx.fill();

          // Sub-diffraction centroid glow ring
          ctx.strokeStyle = `rgba(0, 229, 163, ${pointAlpha * 0.7 * currentIntensity})`;
          ctx.lineWidth = 1;
          ctx.beginPath();
          ctx.arc(x, y, 4.0, 0, Math.PI * 2);
          ctx.stroke();
        }
      });

      ctx.restore();

      // Update Telemetry HUD metrics based on scroll progress
      if (hudPsnr && hudFwhm && hudRegime) {
        const psnrProgress = Math.min(p / 0.68, 1);
        const psnrVal = (18.2 + psnrProgress * (33.8 - 18.2)).toFixed(1);
        const fwhmVal = Math.round(280 - psnrProgress * (280 - 18));
        hudPsnr.textContent = `${psnrVal} dB`;
        hudFwhm.textContent = `${fwhmVal} nm`;

        if (p < 0.28) {
          hudRegime.textContent = 'Diffraction Blur';
        } else if (p < 0.68) {
          hudRegime.textContent = 'Focal Localization';
        } else {
          hudRegime.textContent = 'Sub-diffraction Truth';
        }
      }

      animationFrameId = requestAnimationFrame(render);
    }

    render();

    return () => {
      cancelAnimationFrame(animationFrameId);
      window.removeEventListener('resize', resize);
      unbindScroll();
    };
  });
</script>

