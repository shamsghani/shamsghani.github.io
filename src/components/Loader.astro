---
import { site } from '../data/site';
---

<div id="loader" role="status" aria-label="Initializing instrument and optical reticles">
  <div class="loader__inner">
    <div>
      <div class="loader__title" data-loader-out>{site.shortName}</div>
      <div class="loader__meta" data-loader-out>MACHINE LEARNING ENGINEER · COMPUTER VISION & REPRESENTATION LEARNING</div>
    </div>
    <span class="loader__count" data-loader-out data-loader-count>000</span>
  </div>
  <div class="loader__bar" data-loader-bar></div>
</div>

