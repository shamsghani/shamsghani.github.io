---
// FigureMetacognition.astro — Interactive Metacognitive Reasoning Harness Visualizer
---

<div class="meta-studio" data-reveal="up" id="fig-metacognition">
  <div class="meta-header">
    <div class="meta-label">
      <span class="mono-badge">Fig 02</span>
      <span>Cognitive Architecture Simulation</span>
    </div>
    <h3 class="meta-title">Recursive Reasoning & Metacognitive Gating Harness</h3>
    <p class="meta-desc">
      An ongoing effort to create an executive supervisory harness that acts upon iterative language model reasoning by dynamically measuring semantic drift, verifying logical entailment, and triggering anti-rumination escapes when stuck in cognitive attractor loops.
    </p>
  </div>

  <div class="meta-card">
    <!-- Top System Console Bar -->
    <div class="meta-bar">
      <div class="meta-bar__left">
        <span class="meta-indicator"></span>
        <span class="meta-bar__title">SCS-1 METACOGNITIVE SUPERVISOR</span>
      </div>
      <div class="meta-bar__right">
        <button class="analogy-toggle" id="analogyToggle">
          <span class="toggle-dot"></span>
          <span id="analogyLabel">View: AI Architecture</span>
        </button>
      </div>
    </div>

    <!-- Interactive Simulation Canvas & System Map -->
    <div class="meta-layout">
      <!-- Left: Interactive Schematic Architecture -->
      <div class="schematic-pane">
        <!-- Top Harness Layer: Dual Sensory Evaluators -->
        <div class="harness-layer">
          <!-- Sensor 1: Semantic Drift -->
          <div class="harness-node sensor-drift" id="nodeDrift">
            <div class="node-badge">MONITOR 01</div>
            <div class="node-title" data-ai="Semantic Drift (Δz)" data-human="Semantic Stability">Semantic Drift (Δz)</div>
            <div class="node-metric" id="driftVal">0.74 (Active)</div>
            <div class="meter-bar">
              <div class="meter-fill" id="driftFill" style="width: 74%;"></div>
            </div>
            <span class="node-caption">Measures vector change ||z_t - z_(t-1)||</span>
          </div>

          <!-- Sensor 2: NLI Entailment -->
          <div class="harness-node sensor-entail" id="nodeEntail">
            <div class="node-badge">MONITOR 02</div>
            <div class="node-title" data-ai="NLI Entailment (θ_NLI)" data-human="System 2 Coherence">NLI Entailment (θ_NLI)</div>
            <div class="node-metric" id="entailVal">0.42 (Gaps)</div>
            <div class="meter-bar">
              <div class="meter-fill fill-cyan" id="entailFill" style="width: 42%;"></div>
            </div>
            <span class="node-caption">Verifies step_t entails step_(t-1)</span>
          </div>
        </div>

        <!-- Center: Core Generative Model (Acted Upon) -->
        <div class="core-model-wrap">
          <div class="connection-line conn-down"></div>
          <div class="model-core" id="modelCore">
            <div class="core-header">
              <span class="core-tag" data-ai="CORE REASONING MODEL (LLM)" data-human="SYSTEM 1: GENERATIVE FLOW">CORE REASONING MODEL (LLM)</span>
              <span class="core-step" id="coreStepTag">ITERATION t = 1</span>
            </div>
            <div class="core-thought" id="coreThoughtText">
              "Hypothesis: Emitters at coordinates (12, 45) and (14, 48) represent separate fluorophores, but background noise is ambiguous."
            </div>
            <div class="core-status-row">
              <span class="pulse-light"></span>
              <span class="status-msg" id="coreStatusMsg">Forward Pass Generating Candidates...</span>
            </div>
          </div>
          <div class="connection-line conn-down"></div>
        </div>

        <!-- Bottom Harness Layer: Executive Gate & Anti-Rumination -->
        <div class="harness-layer">
          <!-- Part 4: Anti-Rumination Escape Mechanism -->
          <div class="harness-node node-escape" id="nodeEscape">
            <div class="node-badge">ESCAPE CIRCUIT</div>
            <div class="node-title" data-ai="Anti-Rumination Circuit" data-human="Executive Pattern Interrupt">Anti-Rumination Circuit</div>
            <div class="node-metric metric-subtle" id="escapeVal">Standby · Nominal</div>
            <span class="node-caption">Detects stuck loops · Injects temp ramp</span>
          </div>

          <!-- Part 3: Conjunctive Halting Gate -->
          <div class="harness-node node-gate" id="nodeGate">
            <div class="node-badge">EXECUTIVE GATE</div>
            <div class="node-title" data-ai="Conjunctive Halting Gate" data-human="Feeling of Rightness (FOR)">Conjunctive Halting Gate</div>
            <div class="node-metric metric-accent" id="gateVal">CONTINUE SEARCH</div>
            <span class="node-caption">Halt IF (Drift &lt; ε) ∧ (Entailment &gt; θ)</span>
          </div>
        </div>

        <!-- Sliding Window Feedback Loop -->
        <div class="feedback-arc" aria-hidden="true">
          <span class="arc-line"></span>
          <span class="arc-label" data-ai="SLIDING WINDOW RECAP (NO CONTEXT SATURATION)" data-human="WORKING MEMORY BUFFER (BADDELEY)">SLIDING WINDOW RECAP (NO CONTEXT SATURATION)</span>
        </div>
      </div>

      <!-- Right: Real-time Telemetry & Log Console -->
      <div class="telemetry-pane">
        <div class="telemetry-box">
          <span class="telemetry-kicker">EXECUTIVE SUPERVISOR LOG</span>
          <div class="console-screen" id="consoleScreen" role="log" tabindex="0" aria-label="Executive Supervisor Event Log" aria-live="polite">
            <div class="log-line log-system">[INIT] SCS-1 Metacognitive Harness active.</div>
            <div class="log-line log-info">[t=1] Sampling initial reasoning chain...</div>
            <div class="log-line">[t=1] Drift: 0.74 (unstable) · Entailment: 0.42 (insufficient)</div>
            <div class="log-line log-warn">[t=1] Gate: CRITERIA UNMET. Dispatching feedback.</div>
          </div>
        </div>

        <!-- Scenario Control Selector -->
        <div class="scenario-selector">
          <span class="selector-kicker">TEST SCENARIOS</span>
          <div class="scenario-btns" role="tablist" aria-label="Metacognitive Scenario Selector">
            <button class="scenario-btn is-active" data-scenario="multistep" role="tab" aria-selected="true">
              <span class="btn-dot"></span>
              <div class="btn-text">
                <span class="btn-name">Multi-Step Convergence</span>
                <span class="btn-sub">3 passes · Optimal Halting</span>
              </div>
            </button>
            <button class="scenario-btn" data-scenario="easy" role="tab" aria-selected="false">
              <span class="btn-dot"></span>
              <div class="btn-text">
                <span class="btn-name">Easy Problem Early Exit</span>
                <span class="btn-sub">1 pass · 68% token reduction</span>
              </div>
            </button>
            <button class="scenario-btn" data-scenario="rumination" role="tab" aria-selected="false">
              <span class="btn-dot dot-warn"></span>
              <div class="btn-text">
                <span class="btn-name">Rumination & Escape</span>
                <span class="btn-sub">Stuck state · Temp ramp breakout</span>
              </div>
            </button>
          </div>
        </div>

        <!-- Comparative Metrics Summary -->
        <div class="efficiency-summary">
          <div class="eff-stat">
            <span class="eff-label">REASONING ACCURACY</span>
            <span class="eff-val val-green" id="effAcc">94.2%</span>
          </div>
          <div class="eff-stat">
            <span class="eff-label">COMPUTE ALLOCATION</span>
            <span class="eff-val" id="effTokens">Adaptive (-48% tokens)</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="meta-footer-note">
    <strong>Cognitive Justification:</strong> Human reasoning does not execute fixed-length computation. Executive metacognition monitors the internal "Feeling of Rightness" to halt when reasoning has converged, while pattern interrupts prevent depressive rumination loops. SCS-1 replicates this executive oversight externally around any generative model.
  </div>
</div>

<style>
  .meta-studio {
    margin: 3.5rem 0;
    font-family: var(--f-sans, system-ui, sans-serif);
  }

  .meta-header {
    margin-bottom: 1.5rem;
  }

  .meta-label {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--f-mono);
    font-size: var(--t-xs, 0.75rem);
    color: var(--c-muted);
    margin-bottom: 0.5rem;
  }

  .mono-badge {
    padding: 0.15rem 0.45rem;
    background: rgba(0, 229, 163, 0.12);
    color: var(--c-accent, #00e5a3);
    border: 1px solid rgba(0, 229, 163, 0.3);
    border-radius: 2px;
    font-weight: 500;
  }

  .meta-title {
    font-family: var(--f-display, system-ui);
    font-size: clamp(1.25rem, 1.1rem + 1vw, 1.75rem);
    font-weight: 600;
    color: var(--c-fg);
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
  }

  .meta-desc {
    color: var(--c-muted);
    font-size: 0.92rem;
    line-height: 1.55;
    max-width: 68ch;
  }

  .meta-card {
    background: #090c12;
    border: 1px solid rgba(238, 243, 248, 0.12);
    border-radius: 4px;
    overflow: hidden;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5);
  }

  .meta-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 1.1rem;
    background: #06080c;
    border-bottom: 1px solid rgba(238, 243, 248, 0.08);
    font-family: var(--f-mono);
    font-size: 0.72rem;
  }

  .meta-bar__left {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .meta-indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--c-accent, #00e5a3);
    box-shadow: 0 0 8px var(--c-accent, #00e5a3);
  }

  .meta-bar__title {
    color: var(--c-fg);
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  .analogy-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.7rem;
    background: rgba(238, 243, 248, 0.05);
    border: 1px solid rgba(238, 243, 248, 0.15);
    border-radius: 3px;
    font-family: var(--f-mono);
    font-size: 0.68rem;
    color: var(--c-fg);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .analogy-toggle:hover {
    background: rgba(0, 229, 163, 0.08);
    border-color: var(--c-accent, #00e5a3);
    transform: translateY(-1px);
  }

  .toggle-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #38bdf8;
  }

  .meta-layout {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    background: #040507;
  }

  .schematic-pane {
    position: relative;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    border-right: 1px solid rgba(238, 243, 248, 0.08);
    background: radial-gradient(circle at 50% 50%, rgba(14, 20, 28, 0.5) 0%, rgba(4, 5, 7, 0.95) 100%);
  }

  .harness-layer {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    position: relative;
    z-index: 2;
  }

  .harness-node {
    background: rgba(238, 243, 248, 0.03);
    border: 1px solid rgba(238, 243, 248, 0.1);
    border-radius: 4px;
    padding: 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    transition: all 0.25s ease;
  }

  .harness-node.is-active-pulse {
    border-color: var(--c-accent, #00e5a3);
    box-shadow: 0 0 16px rgba(0, 229, 163, 0.25);
    background: rgba(0, 229, 163, 0.04);
  }

  .node-badge {
    font-family: var(--f-mono);
    font-size: 0.58rem;
    color: var(--c-muted);
    letter-spacing: 0.08em;
  }

  .node-title {
    font-family: var(--f-display, system-ui);
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--c-fg);
  }

  .node-metric {
    font-family: var(--f-mono);
    font-size: 0.82rem;
    font-weight: 600;
    color: #38bdf8;
    margin-top: 0.15rem;
  }

  .metric-accent {
    color: var(--c-accent, #00e5a3);
  }

  .metric-subtle {
    color: var(--c-muted);
  }

  .meter-bar {
    width: 100%;
    height: 4px;
    background: rgba(238, 243, 248, 0.1);
    border-radius: 2px;
    overflow: hidden;
    margin: 0.25rem 0;
  }

  .meter-fill {
    height: 100%;
    background: var(--c-accent, #00e5a3);
    transition: width 0.4s ease;
  }

  .meter-fill.fill-cyan {
    background: #38bdf8;
  }

  .node-caption {
    font-size: 0.68rem;
    color: var(--c-muted);
    line-height: 1.35;
  }

  .core-model-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    z-index: 2;
  }

  .connection-line {
    width: 1px;
    height: 16px;
    background: rgba(238, 243, 248, 0.18);
  }

  .model-core {
    width: 100%;
    background: #070a0f;
    border: 1px solid rgba(56, 189, 248, 0.28);
    border-radius: 4px;
    padding: 1.1rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .core-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid rgba(238, 243, 248, 0.08);
    padding-bottom: 0.45rem;
  }

  .core-tag {
    font-family: var(--f-mono);
    font-size: 0.65rem;
    font-weight: 600;
    color: #38bdf8;
    letter-spacing: 0.06em;
  }

  .core-step {
    font-family: var(--f-mono);
    font-size: 0.65rem;
    color: var(--c-accent, #00e5a3);
    background: rgba(0, 229, 163, 0.1);
    padding: 0.15rem 0.4rem;
    border-radius: 2px;
  }

  .core-thought {
    font-family: var(--f-mono);
    font-size: 0.78rem;
    color: var(--c-fg);
    line-height: 1.5;
    min-height: 2.8rem;
  }

  .core-status-row {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--f-mono);
    font-size: 0.64rem;
    color: var(--c-muted);
  }

  .pulse-light {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #38bdf8;
    animation: pulse-core 1.8s infinite;
  }

  @keyframes pulse-core {
    0%, 100% { opacity: 0.3; }
    50% { opacity: 1; }
  }

  .feedback-arc {
    position: absolute;
    inset: 12px 10px;
    border: 1px dashed rgba(56, 189, 248, 0.18);
    border-radius: 8px;
    pointer-events: none;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-bottom: 4px;
  }

  .arc-label {
    font-family: var(--f-mono);
    font-size: 0.58rem;
    color: #38bdf8;
    background: #040507;
    padding: 0 0.5rem;
    letter-spacing: 0.06em;
  }

  .telemetry-pane {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 1.5rem;
    background: #090c12;
    border-left: 1px solid rgba(238, 243, 248, 0.08);
  }

  .telemetry-box {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .telemetry-kicker {
    font-family: var(--f-mono);
    font-size: 0.62rem;
    color: var(--c-muted);
    letter-spacing: 0.08em;
  }

  .console-screen {
    background: #030406;
    border: 1px solid rgba(238, 243, 248, 0.08);
    border-radius: 3px;
    padding: 0.85rem;
    height: 140px;
    overflow-y: auto;
    font-family: var(--f-mono);
    font-size: 0.7rem;
    line-height: 1.55;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .log-line { color: var(--c-muted); }
  .log-system { color: #38bdf8; }
  .log-info { color: var(--c-fg); }
  .log-warn { color: #f59e0b; }
  .log-success { color: var(--c-accent, #00e5a3); }

  .scenario-selector {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .selector-kicker {
    font-family: var(--f-mono);
    font-size: 0.62rem;
    color: var(--c-muted);
    letter-spacing: 0.08em;
  }

  .scenario-btns {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .scenario-btn {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.65rem 0.85rem;
    background: rgba(238, 243, 248, 0.03);
    border: 1px solid rgba(238, 243, 248, 0.1);
    border-radius: 3px;
    text-align: left;
    cursor: pointer;
    transition: all 0.2s ease;
    min-height: 48px;
  }

  .scenario-btn:hover {
    background: rgba(238, 243, 248, 0.07);
    border-color: rgba(238, 243, 248, 0.25);
    transform: translateY(-1px);
  }

  .scenario-btn.is-active {
    background: rgba(0, 229, 163, 0.08);
    border-color: var(--c-accent, #00e5a3);
    box-shadow: 0 0 12px rgba(0, 229, 163, 0.18);
  }

  .btn-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--c-accent, #00e5a3);
    flex-shrink: 0;
  }

  .btn-dot.dot-warn {
    background: #f59e0b;
  }

  .btn-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .btn-name {
    font-family: var(--f-display, system-ui);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--c-fg);
  }

  .btn-sub {
    font-family: var(--f-mono);
    font-size: 0.65rem;
    color: var(--c-muted);
  }

  .efficiency-summary {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 0.5rem;
    border-top: 1px solid rgba(238, 243, 248, 0.08);
  }

  .eff-stat {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .eff-label {
    font-family: var(--f-mono);
    font-size: 0.58rem;
    color: var(--c-muted);
    letter-spacing: 0.05em;
  }

  .eff-val {
    font-family: var(--f-mono);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--c-fg);
  }

  .val-green {
    color: var(--c-accent, #00e5a3);
  }

  .meta-footer-note {
    margin-top: 1rem;
    padding: 0.85rem 1.1rem;
    background: rgba(238, 243, 248, 0.02);
    border-left: 2px solid var(--c-accent, #00e5a3);
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--c-muted);
  }

  .meta-footer-note strong {
    color: var(--c-fg);
  }

  /* Light Theme Metacognitive Studio Styling */
  :global([data-theme="light"]) .meta-card {
    background: #ffffff;
    border-color: rgba(10, 16, 29, 0.12);
    box-shadow: 0 12px 32px rgba(10, 16, 29, 0.06);
  }

  :global([data-theme="light"]) .meta-bar {
    background: #f8fafc;
    border-bottom-color: rgba(10, 16, 29, 0.08);
  }

  :global([data-theme="light"]) .meta-bar__title {
    color: #0f172a;
  }

  :global([data-theme="light"]) .analogy-toggle {
    background: #ffffff;
    border-color: rgba(10, 16, 29, 0.16);
    color: #0f172a;
  }

  :global([data-theme="light"]) .schematic-pane {
    background: #f8fafc;
    border-right-color: rgba(10, 16, 29, 0.08);
  }

  :global([data-theme="light"]) .harness-node {
    background: #ffffff;
    border-color: rgba(10, 16, 29, 0.12);
    box-shadow: 0 2px 8px rgba(10, 16, 29, 0.04);
  }

  :global([data-theme="light"]) .node-title {
    color: #0f172a;
  }

  :global([data-theme="light"]) .node-caption {
    color: #64748b;
  }

  :global([data-theme="light"]) .meter-bar {
    background: rgba(10, 16, 29, 0.08);
  }

  :global([data-theme="light"]) .model-core {
    background: #ffffff;
    border-color: rgba(2, 132, 199, 0.4);
    box-shadow: 0 4px 16px rgba(2, 132, 199, 0.08);
  }

  :global([data-theme="light"]) .core-header {
    border-bottom-color: rgba(10, 16, 29, 0.08);
  }

  :global([data-theme="light"]) .core-thought {
    color: #0f172a;
  }

  :global([data-theme="light"]) .core-status-row {
    color: #64748b;
  }

  :global([data-theme="light"]) .arc-label {
    background: #f8fafc;
    color: #0284c7;
  }

  :global([data-theme="light"]) .telemetry-pane {
    background: #ffffff;
    border-left-color: rgba(10, 16, 29, 0.08);
  }

  :global([data-theme="light"]) .console-screen {
    background: #f8fafc;
    border-color: rgba(10, 16, 29, 0.1);
  }

  :global([data-theme="light"]) .log-line {
    color: #475569;
  }

  :global([data-theme="light"]) .log-system {
    color: #0284c7;
  }

  :global([data-theme="light"]) .log-info {
    color: #0f172a;
  }

  :global([data-theme="light"]) .scenario-btn {
    background: #ffffff;
    border-color: rgba(10, 16, 29, 0.12);
  }

  :global([data-theme="light"]) .scenario-btn:hover {
    background: #f1f5f9;
    border-color: rgba(10, 16, 29, 0.25);
  }

  :global([data-theme="light"]) .scenario-btn.is-active {
    background: rgba(5, 150, 105, 0.08);
    border-color: #059669;
  }

  :global([data-theme="light"]) .btn-name {
    color: #0f172a;
  }

  :global([data-theme="light"]) .btn-sub {
    color: #64748b;
  }

  :global([data-theme="light"]) .efficiency-summary {
    border-top-color: rgba(10, 16, 29, 0.08);
  }

  :global([data-theme="light"]) .eff-val {
    color: #0f172a;
  }

  :global([data-theme="light"]) .meta-footer-note {
    background: #f8fafc;
    border-left-color: #059669;
    color: #475569;
  }

  @media (max-width: 900px) {
    .meta-layout {
      grid-template-columns: 1fr;
    }
    .schematic-pane {
      border-right: none;
      border-bottom: 1px solid rgba(238, 243, 248, 0.08);
    }
  }
</style>

<script>
  import { onPage } from '@/engine';

  onPage(() => {
    // DOM elements
    const toggleBtn = document.getElementById('analogyToggle');
    const analogyLabel = document.getElementById('analogyLabel');
    const scenarioBtns = document.querySelectorAll<HTMLButtonElement>('.scenario-btn');

    // Harness Nodes
    const nodeDrift = document.getElementById('nodeDrift');
    const nodeEntail = document.getElementById('nodeEntail');
    const nodeGate = document.getElementById('nodeGate');
    const nodeEscape = document.getElementById('nodeEscape');

    // Metric Displays
    const driftVal = document.getElementById('driftVal');
    const driftFill = document.getElementById('driftFill');
    const entailVal = document.getElementById('entailVal');
    const entailFill = document.getElementById('entailFill');
    const gateVal = document.getElementById('gateVal');
    const escapeVal = document.getElementById('escapeVal');

    // Core Thought Display
    const coreStepTag = document.getElementById('coreStepTag');
    const coreThoughtText = document.getElementById('coreThoughtText');
    const coreStatusMsg = document.getElementById('coreStatusMsg');
    const consoleScreen = document.getElementById('consoleScreen');

    // Summary metrics
    const effAcc = document.getElementById('effAcc');
    const effTokens = document.getElementById('effTokens');

    let isHumanMode = false;
    let currentScenario = 'multistep';
    let simTimeout: number | undefined;

    // Toggle between AI terminology and Human Cognitive Psychology
    toggleBtn?.addEventListener('click', () => {
      isHumanMode = !isHumanMode;
      if (analogyLabel) {
        analogyLabel.textContent = isHumanMode ? 'View: Cognitive Psychology' : 'View: AI Architecture';
      }

      const elementsWithData = document.querySelectorAll<HTMLElement>('[data-ai]');
      elementsWithData.forEach((el) => {
        const aiText = el.getAttribute('data-ai');
        const humanText = el.getAttribute('data-human');
        if (aiText && humanText) {
          el.textContent = isHumanMode ? humanText : aiText;
        }
      });
    });

    const scenarios = {
      multistep: {
        steps: [
          {
            step: 1,
            thought: 'Pass 1: "Initial hypothesis proposes coordinate centroid at (142.5, 88.0), but residual loss indicates localized ambiguity."',
            drift: 0.78,
            entail: 0.38,
            gate: 'CONTINUE SEARCH',
            gateActive: false,
            escape: 'Standby · Nominal',
            escapeWarn: false,
            log: '[t=1] Draft generated. Drift: 0.78 (active) · Entailment: 0.38 (flawed). Gate: CONTINUE.',
            acc: '78.5%',
            tokens: 'Iteration 1/3'
          },
          {
            step: 2,
            thought: 'Pass 2: "Sliding window refinement: Correcting coordinate bias. Centroid shifted to (140.2, 89.1). Cross-entropy stabilizing."',
            drift: 0.32,
            entail: 0.74,
            gate: 'VERIFYING STABILITY',
            gateActive: false,
            escape: 'Standby · Nominal',
            escapeWarn: false,
            log: '[t=2] Refinement pass. Drift: 0.32 · Entailment: 0.74. Logic converging.',
            acc: '88.1%',
            tokens: 'Iteration 2/3'
          },
          {
            step: 3,
            thought: 'Pass 3: "Convergence achieved: Coordinate centroid verified at sub-diffraction 18nm resolution. Zero remaining logical gaps."',
            drift: 0.08,
            entail: 0.94,
            gate: 'HALT: OPTIMAL CONVERGENCE',
            gateActive: true,
            escape: 'Standby · Verified',
            escapeWarn: false,
            log: '[t=3] [CRITERIA MET] Drift (0.08 < 0.15) ∧ Entailment (0.94 > 0.85). EMITTING SOLUTION.',
            acc: '94.2%',
            tokens: '-48% compute vs fixed'
          }
        ]
      },
      easy: {
        steps: [
          {
            step: 1,
            thought: 'Pass 1: "Direct solution derived immediately from input prompt. Closed-form coordinate mapping confirmed with zero ambiguity."',
            drift: 0.05,
            entail: 0.96,
            gate: 'HALT: EARLY EXIT (t=1)',
            gateActive: true,
            escape: 'Standby · Nominal',
            escapeWarn: false,
            log: '[t=1] [EASY QUERY DETECTED] High entailment (0.96) + Low drift (0.05). Halting immediately at t=1. Tokens saved: 68%.',
            acc: '98.0%',
            tokens: '-68% token reduction'
          }
        ]
      },
      rumination: {
        steps: [
          {
            step: 1,
            thought: 'Pass 1: "Hypothesis: Applying standard L2 gradient leads to coordinate collapse at (50, 50). Retaining assumption."',
            drift: 0.65,
            entail: 0.40,
            gate: 'CONTINUE SEARCH',
            gateActive: false,
            escape: 'Standby · Nominal',
            escapeWarn: false,
            log: '[t=1] Initial pass: Entailment low (0.40). Iterating...',
            acc: '45.0%',
            tokens: 'Iteration 1'
          },
          {
            step: 2,
            thought: 'Pass 2: "Re-evaluating: Still stuck on L2 coordinate collapse. Minor wording variation, but core flaw repeated."',
            drift: 0.12,
            entail: 0.38,
            gate: 'REJECTED: STUCK STATE',
            gateActive: false,
            escape: 'WARNING: Rumination Detected',
            escapeWarn: true,
            log: '[t=2] [ALERT] Drift dropped (0.12) but Entailment failed (0.38). Model is ruminating in a local attractor!',
            acc: '48.0%',
            tokens: 'Attractor detected'
          },
          {
            step: 3,
            thought: 'Pass 3 [Escape Injected]: "Temperature ramp (+0.5) injected! Attention disengaged from L2 attractor. Exploring Focal Loss instead!"',
            drift: 0.85,
            entail: 0.62,
            gate: 'SEARCH RE-OPENED',
            gateActive: false,
            escape: 'ESCAPE TRIGGERED (Temp +0.5)',
            escapeWarn: false,
            log: '[t=3] Anti-Rumination Circuit fired temperature ramp (+0.5). Model escaped stuck loop and pivoted.',
            acc: '74.0%',
            tokens: 'Breakout successful'
          },
          {
            step: 4,
            thought: 'Pass 4: "Post-escape derivation confirmed: Focal Loss (γ=2.0) resolves sparse fluorophores at 33.8 dB. Logic sound."',
            drift: 0.09,
            entail: 0.95,
            gate: 'HALT: POST-ESCAPE SOLUTION',
            gateActive: true,
            escape: 'Stabilized Post-Breakout',
            escapeWarn: false,
            log: '[t=4] [CRITERIA MET] Post-escape convergence verified. Emitting solution.',
            acc: '92.5%',
            tokens: 'Recovered & Verified'
          }
        ]
      }
    };

    function runStep(scenarioKey: string, stepIndex: number) {
      const data = scenarios[scenarioKey as keyof typeof scenarios];
      if (!data) return;
      const step = data.steps[stepIndex];
      if (!step) return;

      // Update UI
      if (coreStepTag) coreStepTag.textContent = `ITERATION t = ${step.step}`;
      if (coreThoughtText) coreThoughtText.textContent = step.thought;
      if (coreStatusMsg) coreStatusMsg.textContent = step.gateActive ? 'Reasoning Complete · Solution Emitted' : 'Evaluating Harness Metrics...';

      if (driftVal) driftVal.textContent = `${(step.drift * 100).toFixed(0)}% (${step.drift < 0.2 ? 'Stable' : 'Active'})`;
      if (driftFill) driftFill.style.width = `${step.drift * 100}%`;

      if (entailVal) entailVal.textContent = `${(step.entail * 100).toFixed(0)}% (${step.entail > 0.85 ? 'Sound' : 'Gaps'})`;
      if (entailFill) entailFill.style.width = `${step.entail * 100}%`;

      if (gateVal) {
        gateVal.textContent = step.gate;
        gateVal.className = `node-metric ${step.gateActive ? 'metric-accent' : 'metric-subtle'}`;
      }

      if (escapeVal) {
        escapeVal.textContent = step.escape;
        escapeVal.style.color = step.escapeWarn ? '#f59e0b' : '';
      }

      if (nodeGate) {
        nodeGate.classList.toggle('is-active-pulse', step.gateActive);
      }
      if (nodeEscape) {
        nodeEscape.classList.toggle('is-active-pulse', step.escapeWarn);
      }

      // Add log line
      if (consoleScreen) {
        const line = document.createElement('div');
        line.className = `log-line ${step.gateActive ? 'log-success' : step.escapeWarn ? 'log-warn' : 'log-info'}`;
        line.textContent = step.log;
        consoleScreen.appendChild(line);
        consoleScreen.scrollTop = consoleScreen.scrollHeight;
      }

      if (effAcc) effAcc.textContent = step.acc;
      if (effTokens) effTokens.textContent = step.tokens;

      // Advance to next step if available
      if (stepIndex + 1 < data.steps.length) {
        simTimeout = window.setTimeout(() => {
          runStep(scenarioKey, stepIndex + 1);
        }, 1800);
      }
    }

    function startScenario(key: string) {
      currentScenario = key;
      if (simTimeout) clearTimeout(simTimeout);

      scenarioBtns.forEach((btn) => {
        const isActive = btn.dataset.scenario === key;
        btn.classList.toggle('is-active', isActive);
        btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });

      if (consoleScreen) {
        consoleScreen.innerHTML = `<div class="log-line log-system">[INIT] Starting scenario: ${key}...</div>`;
      }

      runStep(key, 0);
    }

    scenarioBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const scenario = btn.dataset.scenario;
        if (scenario) startScenario(scenario);
      });
    });

    // Start default scenario
    startScenario('multistep');

    return () => {
      if (simTimeout) clearTimeout(simTimeout);
    };
  });
</script>
